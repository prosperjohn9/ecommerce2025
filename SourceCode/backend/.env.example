# Copy this file to .env in the same folder and fill in the values.
# .env is gitignored. Spring Boot reads it on startup (see application.properties).
# Real environment variables take precedence over this file.

DB_URL=jdbc:postgresql://localhost:5432/ecommdb
DB_USERNAME=postgres
DB_PASSWORD=

# Browser origin(s) of the React app, comma-separated. Only these may call the API with cookies.
FRONTEND_ORIGIN=http://localhost:3000
